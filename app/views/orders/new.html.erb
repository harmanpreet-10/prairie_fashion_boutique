
<main class="store-container">
  <h1>Checkout</h1>
  <p>Complete your information to place your order.</p>

  <% if @order.errors.any? %>
    <div class="empty-state" role="alert">
      <h2>Please correct the following errors:</h2>
      <ul>
        <% @order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @order, url: orders_path do |form| %>
    <section class="cart-summary">
      <h2>Customer Information</h2>

      <p>
        <%= form.label :customer_name, "Full Name" %>
        <%= form.text_field :customer_name, required: true %>
      </p>

      <p>
        <%= form.label :email, "Email Address" %>
        <%= form.email_field :email, required: true %>
      </p>

      <p>
        <%= form.label :shipping_address, "Shipping Address" %>
        <%= form.text_area :shipping_address, rows: 4, required: true %>
      </p>

      <p>
        <%= form.label :province, "Province or Territory" %>
        <%= form.select :province,
              CanadianSalesTax::PROVINCES.to_a,
              { prompt: "Select your province" },
              { required: true, id: "checkout-province" } %>
      </p>

      <h2>Order Summary</h2>

      <% @cart_items.each do |item| %>
        <p>
          <%= item[:product].name %>
          &times; <%= item[:quantity] %>
          &mdash; <%= number_to_currency(item[:line_total]) %>
        </p>
      <% end %>

      <hr>

      <p>
        Subtotal:
        <strong><%= number_to_currency(@order.subtotal) %></strong>
      </p>

      <div id="checkout-tax-summary"
           data-subtotal="<%= @order.subtotal %>"
           data-rates="<%= CanadianSalesTax::RATES.to_json %>">

        <p>GST: <span id="checkout-gst">$0.00</span></p>
        <p>PST/QST: <span id="checkout-pst">$0.00</span></p>
        <p>HST: <span id="checkout-hst">$0.00</span></p>

        <h2>
          Estimated Total:
          <span id="checkout-total">
            <%= number_to_currency(@order.total) %>
          </span>
        </h2>
      </div>

      <p>
        <small>
          Tax estimates update when you select a province.
          Final taxes are calculated on the server when you place
          your order. Shipping is free.
        </small>
      </p>

      <%= form.submit "Place Order", class: "shop-button" %>
    </section>
  <% end %>

  <p><%= link_to "Back to Cart", cart_path %></p>
</main>

<script>
  (() => {
    function initializeCheckoutTax() {
      const province = document.getElementById("checkout-province");
      const summary = document.getElementById("checkout-tax-summary");

      if (!province || !summary || summary.dataset.initialized === "true") {
        return;
      }

      summary.dataset.initialized = "true";

      const subtotalCents = Math.round(
        Number(summary.dataset.subtotal) * 100
      );

      const rates = JSON.parse(summary.dataset.rates);

      const currency = (cents) =>
        new Intl.NumberFormat("en-CA", {
          style: "currency",
          currency: "CAD"
        }).format(cents / 100);

      const calculateTax = (rate) =>
        Math.round(subtotalCents * Number(rate));

      function updateTaxPreview() {
        const selectedRates = rates[province.value];

        if (!selectedRates) {
          document.getElementById("checkout-gst").textContent = "—";
          document.getElementById("checkout-pst").textContent = "—";
          document.getElementById("checkout-hst").textContent = "—";
          document.getElementById("checkout-total").textContent =
            "Select a province";
          return;
        }

        const gst = calculateTax(selectedRates.gst);
        const pst = calculateTax(selectedRates.pst);
        const hst = calculateTax(selectedRates.hst);

        document.getElementById("checkout-gst").textContent =
          currency(gst);

        document.getElementById("checkout-pst").textContent =
          currency(pst);

        document.getElementById("checkout-hst").textContent =
          currency(hst);

        document.getElementById("checkout-total").textContent =
          currency(subtotalCents + gst + pst + hst);
      }

      province.addEventListener("change", updateTaxPreview);
      updateTaxPreview();
    }

    document.addEventListener("turbo:load", initializeCheckoutTax);

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        initializeCheckoutTax,
        { once: true }
      );
    } else {
      initializeCheckoutTax();
    }
  })();
</script>
