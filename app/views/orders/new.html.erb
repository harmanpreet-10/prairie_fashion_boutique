
<main class="store-container">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <%= link_to "Home", root_path %> /
    <%= link_to "Shopping Cart", cart_path %> /
    <span>Checkout</span>
  </nav>

  <h1>Checkout</h1>
  <p>Complete your information to place your order.</p>

  <% if @order.errors.any? %>
    <div class="empty-state" role="alert">
      <h2>Please correct the following errors:</h2>
      <ul>
        <% @order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @order, url: orders_path do |form| %>
    <section class="cart-summary">
      <h2>Customer Information</h2>

      <p>
        <%= form.label :customer_name, "Full Name" %>
        <%= form.text_field :customer_name, required: true %>
      </p>

      <p>
        <%= form.label :email, "Email Address" %>
        <%= form.email_field :email, required: true %>
      </p>

      <p>
        <%= form.label :shipping_address, "Shipping Address" %>
        <%= form.text_area :shipping_address,
              rows: 4, required: true %>
      </p>

      <p>
        <%= form.label :province, "Province or Territory" %>
        <%= form.select :province,
              CanadianSalesTax::PROVINCES.to_a,
              { prompt: "Select your province" },
              { required: true } %>
      </p>

      <h2>Order Summary</h2>

      <% @cart_items.each do |item| %>
        <p>
          <%= item[:product].name %>
          × <%= item[:quantity] %>
          — <%= number_to_currency(item[:line_total]) %>
        </p>
      <% end %>

      <hr>

      <p>
        Subtotal:
        <%= number_to_currency(@order.subtotal) %>
      </p>

      <% if CanadianSalesTax::RATES.key?(@order.province) %>
        <p>GST: <%= number_to_currency(@order.gst_amount) %></p>
        <p>PST/QST: <%= number_to_currency(@order.pst_amount) %></p>
        <p>HST: <%= number_to_currency(@order.hst_amount) %></p>

        <h2>
          Estimated Total:
          <%= number_to_currency(@order.total) %>
        </h2>
      <% else %>
        <p>Taxes will be calculated for your province.</p>
      <% end %>

      <p>
        <small>
          The final tax amount is calculated when you place
          your order. Shipping is not charged.
        </small>
      </p>

      <%= form.submit "Place Order", class: "shop-button" %>
    </section>
  <% end %>

  <p>
    <%= link_to "Back to Cart", cart_path %>
  </p>
</main>
