
<main class="store-container">
  <section class="information-page">
    <div class="information-page-header">
      <p class="category-label">Prairie Fashion Boutique</p>

      <h1><%= @page.title %></h1>
    </div>

    <div class="information-page-content">
      <%= simple_format(h(@page.content)) %>
    </div>

    <div class="information-page-actions">
      <%= link_to "Explore Our Collection",
          products_path,
          class: "shop-button" %>
    </div>
  </section>
</main>
