
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Prairie Fashion Boutique</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application",
        "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="nav-container">
        <%= link_to "PRAIRIE FASHION",
            root_path,
            class: "brand" %>

        <nav aria-label="Main navigation">
          <%= link_to "Home", root_path %>
          <%= link_to "Shop", products_path %>
          <%= link_to "Categories", categories_path %>

          <% cart_count = (session[:cart] || {}).values.sum(&:to_i) %>

          <%= link_to "Cart (#{cart_count})", cart_path %>

          <%= link_to "Admin", admin_root_path %>
        </nav>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash-message" role="status">
        <%= message %>
      </div>
    <% end %>

    <% unless controller_path.start_with?("admin/", "active_admin/", "devise/") ||
              (controller_name == "products" && action_name == "show") %>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <%= link_to "Home", root_path %>

        <% if controller_name == "products" && action_name == "index" %>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Shop</span>

        <% elsif controller_name == "categories" && action_name == "index" %>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Categories</span>

        <% elsif controller_name == "categories" && action_name == "show" %>
          <span aria-hidden="true"> / </span>
          <%= link_to "Categories", categories_path %>
          <span aria-hidden="true"> / </span>
          <span aria-current="page"><%= @category.name %></span>

        <% elsif controller_name == "carts" %>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Cart</span>

        <% elsif controller_name == "orders" && action_name == "new" %>
          <span aria-hidden="true"> / </span>
          <%= link_to "Cart", cart_path %>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Checkout</span>

        <% elsif controller_name == "orders" && action_name == "show" %>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">Order Confirmation</span>
        <% end %>
      </nav>
    <% end %>

    <%= yield %>

    <footer class="site-footer">
      <p>Prairie Fashion Boutique</p>
      <p>Winnipeg, Manitoba, Canada</p>
      <p>Affordable Fashion. Everyday Confidence.</p>
    </footer>
  </body>
</html>
